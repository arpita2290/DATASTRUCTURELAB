#include <stdio.h>

int main() {
    int n, first = 0, second = 1, next, i;
    printf("Enter the number of terms: ");
    scanf("%d", &n);

    printf("Fibonacci series: ");
    for(i = 0; i < n; i++) {
        if(i == 0)
            next = 0;
        else if(i == 1)
            next = 1;
        else
            next = first + second;

        printf("%d ", next);
        first = second;
        second = next;
    }

    return 0;
}
